<odoo>
    <record id="view_institute_room_list" model="ir.ui.view">
        <field name="name">institute.room.list</field>
        <field name="model">institute.room</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="building"/>
                <field name="floor"/>
                <field name="capacity"/>
                <field name="is_virtual"/>
            </list>
        </field>
    </record>

    <record id="view_institute_room_form" model="ir.ui.view">
        <field name="name">institute.room.form</field>
        <field name="model">institute.room</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="building"/>
                        <field name="floor"/>
                        <field name="capacity"/>
                        <field name="is_virtual"/>
                        <field name="meeting_link" invisible="not is_virtual"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_institute_room_kanban" model="ir.ui.view">
        <field name="name">institute.room.kanban.floorplan</field>
        <field name="model">institute.room</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="floorplan_status"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_card p-3 {{record.floorplan_status.raw_value == 'green' ? 'bg-success' : record.floorplan_status.raw_value == 'yellow' ? 'bg-warning' : record.floorplan_status.raw_value == 'red' ? 'bg-danger' : 'bg-light'}}">
                            <strong><field name="name"/></strong>
                            <div><field name="building"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_institute_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">institute.room</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem id="menu_institute_infrastructure" name="Infrastructure" parent="menu_institute_root"/>
    <menuitem id="menu_institute_room" name="Rooms" parent="menu_institute_infrastructure" action="action_institute_room"/>
    <menuitem id="menu_institute_floorplan" name="Live Floorplan" parent="menu_institute_scheduling" action="action_institute_room"/>
</odoo>
