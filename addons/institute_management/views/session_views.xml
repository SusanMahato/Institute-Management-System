<odoo>
    <record id="view_institute_session_list" model="ir.ui.view">
        <field name="name">institute.class.session.list</field>
        <field name="model">institute.class.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="topic_id"/>
                <field name="teacher_id"/>
                <field name="room_id"/>
                <field name="batch_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_institute_session_form" model="ir.ui.view">
        <field name="name">institute.class.session.form</field>
        <field name="model">institute.class.session</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_unavailable" type="object" string="Mark Unavailable (SOS)"
                            class="btn-danger" invisible="state != 'scheduled'"/>
                    <button name="action_open_substitute_wizard" type="object" string="Find Substitute"
                            class="btn-primary" invisible="state != 'needs_substitute'"/>
                    <button name="action_acknowledge" type="object" string="Acknowledge Assignment"
                            class="btn-warning" invisible="state != 'substituted' or acknowledged"/>
                    <button name="action_log_syllabus" type="object" string="Log Syllabus Progress"
                            class="btn-secondary"/>        
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'substituted' or acknowledged">
                        This assignment requires acknowledgment from the assigned teacher.
                    </div>
                    <group>
                        <field name="topic_id"/>
                        <field name="course_id" readonly="1"/>
                        <field name="subject_id" readonly="1"/>
                        <field name="teacher_id"/>
                        <field name="original_teacher_id" invisible="not original_teacher_id"/>
                        <field name="room_id"/>
                        <field name="batch_id"/>
                        <field name="start_datetime"/>
                        <field name="end_datetime"/>
                        <field name="acknowledged" invisible="state != 'substituted'"/>
                        <field name="acknowledged_by_id" invisible="not acknowledged"/>
                        <field name="acknowledged_at" invisible="not acknowledged"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_institute_session_calendar" model="ir.ui.view">
        <field name="name">institute.class.session.calendar</field>
        <field name="model">institute.class.session</field>
        <field name="arch" type="xml">
            <calendar string="Class Sessions" date_start="start_datetime" date_stop="end_datetime" color="room_id" mode="week">
                <field name="topic_id"/>
                <field name="teacher_id"/>
                <field name="room_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_institute_session_kanban" model="ir.ui.view">
        <field name="name">institute.class.session.kanban</field>
        <field name="model">institute.class.session</field>
        <field name="arch" type="xml">
            <kanban default_group_by="room_id">
                <field name="topic_id"/>
                <field name="teacher_id"/>
                <field name="start_datetime"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click p-2">
                            <strong><field name="topic_id"/></strong>
                            <div><field name="teacher_id"/></div>
                            <div><field name="start_datetime"/></div>
                            <span class="badge"><field name="state"/></span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_institute_session" model="ir.actions.act_window">
        <field name="name">Class Sessions</field>
        <field name="res_model">institute.class.session</field>
        <field name="view_mode">calendar,kanban,list,form</field>
    </record>

    <menuitem id="menu_institute_scheduling" name="Scheduling" parent="menu_institute_root"/>
    <menuitem id="menu_institute_session" name="Class Sessions" parent="menu_institute_scheduling" action="action_institute_session"/>
</odoo>
