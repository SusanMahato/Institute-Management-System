<odoo>
    <record id="view_institute_batch_list" model="ir.ui.view">
        <field name="name">institute.batch.list</field>
        <field name="model">institute.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="course_id"/>
                <field name="batch_completion_percent" widget="progressbar"/>
                <field name="projected_finish_date"/>
                <field name="lagging_flag" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_institute_batch_form" model="ir.ui.view">
        <field name="name">institute.batch.form</field>
        <field name="model">institute.batch</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="course_id"/>
                        <field name="start_date"/>
                        <field name="batch_completion_percent" widget="progressbar" readonly="1"/>
                        <field name="projected_finish_date" readonly="1"/>
                        <field name="lagging_flag" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Students">
                            <field name="student_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_institute_batch" model="ir.actions.act_window">
        <field name="name">Batches</field>
        <field name="res_model">institute.batch</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_institute_progress_tracker" model="ir.actions.act_window">
        <field name="name">Master Progress Tracker</field>
        <field name="res_model">institute.batch</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_institute_batch_list"/>
    </record>

    <menuitem id="menu_institute_batch" name="Batches" parent="menu_institute_curriculum" action="action_institute_batch"/>
    <menuitem id="menu_institute_progress_tracker" name="Master Progress Tracker" parent="menu_institute_syllabus" action="action_institute_progress_tracker" sequence="10"/>
</odoo>
