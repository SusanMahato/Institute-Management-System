<odoo>
    <template id="portal_my_home_batch_link" name="Portal My Home: My Batch Link"
              inherit_id="portal.portal_my_home">
        <xpath expr="//div[@id='portal_common_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">My Batch</t>
                <t t-set="url" t-value="'/my/batch'"/>
                <t t-set="text">View your class schedule and progress</t>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>
</odoo>
