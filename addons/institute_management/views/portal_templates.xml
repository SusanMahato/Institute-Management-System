<odoo>

    <template id="portal_teacher_not_linked" name="Teacher Portal - Not Linked">
        <t t-call="portal.portal_layout">
            <t t-set="title">My Timetable</t>
            <div class="container o_portal_my_home">
                <div class="alert alert-warning mt-4">
                    Your account isn't linked to a teacher profile yet.
                    Please contact your coordinator.
                </div>
            </div>
        </t>
    </template>

    <template id="portal_teacher_timetable" name="Teacher Portal - My Timetable">
        <t t-call="portal.portal_layout">
            <t t-set="title">My Timetable</t>
            <div class="container o_portal_my_home mt-4">
                <h2>My Timetable</h2>
                <p class="text-muted">Welcome, <t t-esc="employee.name"/></p>

                <!-- Needs Acknowledgment: independent of upcoming/history bucketing,
                     since a substituted session counts as "history" immediately
                     regardless of its actual date. -->
                <div t-if="needs_acknowledgment" class="mb-4">
                    <h4 class="text-warning">⚠ Needs Your Acknowledgment</h4>
                    <div t-foreach="needs_acknowledgment" t-as="session"
                         class="alert alert-warning d-flex justify-content-between align-items-center">
                        <div>
                            <strong t-esc="session.topic_id.name"/> — <t t-esc="session.batch_id.name"/>
                            <br/>
                            <span class="text-muted" t-esc="to_local(session.start_datetime)"/>
                        </div>
                        <form t-attf-action="/my/timetable/acknowledge/#{session.id}" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <button type="submit" class="btn btn-sm btn-warning">
                                Acknowledge Assignment
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Upcoming / active sessions -->
                <h4 class="mt-4">Upcoming &amp; Active Classes</h4>
                <table class="table table-hover" t-if="upcoming_sessions">
                    <thead>
                        <tr>
                            <th>When</th>
                            <th>Topic</th>
                            <th>Batch</th>
                            <th>Room</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="upcoming_sessions" t-as="session"
                            t-attf-class="#{session.start_datetime.date() == today and 'table-info' or ''}">
                            <td>
                                <span t-esc="to_local(session.start_datetime)"/>
                                <span t-if="session.start_datetime.date() == today"
                                      class="badge bg-primary ms-1">Today</span>
                            </td>
                            <td t-esc="session.topic_id.name"/>
                            <td t-esc="session.batch_id.name"/>
                            <td t-esc="session.room_id.name"/>
                            <td>
                                <span t-esc="session.state"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <p t-else="" class="text-muted">No upcoming classes.</p>

                <!-- History -->
                <h4 class="mt-4">Recent History</h4>
                <table class="table table-sm" t-if="history_sessions">
                    <thead>
                        <tr>
                            <th>When</th>
                            <th>Topic</th>
                            <th>Batch</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="history_sessions" t-as="session">
                            <td t-esc="to_local(session.start_datetime)"/>
                            <td t-esc="session.topic_id.name"/>
                            <td t-esc="session.batch_id.name"/>
                            <td>
                                <span t-esc="session.state"/>
                                <span t-if="session.state == 'substituted' and session.acknowledged"
                                      class="text-success small ms-1">
                                    ✓ Acknowledged <t t-esc="to_local(session.acknowledged_at)"/>
                                </span>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <p t-else="" class="text-muted">No history yet.</p>
            </div>
        </t>
    </template>
    <template id="portal_teacher_availability" name="Teacher Portal - My Availability">
        <t t-call="portal.portal_layout">
            <t t-set="title">My Availability</t>
            <div class="container o_portal_my_home mt-4">
                <h2>My Availability</h2>
                <p class="text-muted">Welcome, <t t-esc="employee.name"/></p>
                <p class="text-muted">
                    Mark yourself unavailable for a date/time range. Coordinators won't be able
                    to schedule you, and you won't be suggested as a substitute, during these times.
                </p>

                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">Add Unavailable Time</h5>
                        <form action="/my/availability/add" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="row g-3 align-items-end">
                                <div class="col-md-4">
                                    <label class="form-label">From</label>
                                    <input type="datetime-local" name="date_from" class="form-control" required="required"/>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">To</label>
                                    <input type="datetime-local" name="date_to" class="form-control" required="required"/>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Reason</label>
                                    <input type="text" name="reason" class="form-control" placeholder="e.g. Doctor's appointment"/>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary mt-3">Mark Unavailable</button>
                        </form>
                    </div>
                </div>

                <h4>My Unavailable Times</h4>
                <table class="table table-hover" t-if="leaves">
                    <thead>
                        <tr>
                            <th>From</th>
                            <th>To</th>
                            <th>Reason</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="leaves" t-as="leave">
                            <td t-esc="to_local(leave.date_from)"/>
                            <td t-esc="to_local(leave.date_to)"/>
                            <td t-esc="leave.name"/>
                        </tr>
                    </tbody>
                </table>
                <p t-else="" class="text-muted">No unavailable times marked yet.</p>
            </div>
        </t>
    </template>

</odoo>
